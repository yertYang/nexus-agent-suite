# Copy to deployment.env on the host and restrict to mode 0600.
NAVI_DEPLOY_SOURCE=docker
# Direct Docker pull from the installed image's GHCR repository, by tag or digest.
NAVI_DEPLOY_IMAGE=ghcr.io/your-org/your-repo:team-v1.0.0
# For NAVI_DEPLOY_SOURCE=github, configure the repository instead.
# NAVI_DEPLOY_GITHUB_REPO=your-org/your-repo
