{
  "manifest_version": 3,
  "name": "Navi Link",
  "version": "1.0.3",
  "description": "在浏览器侧栏聊天、操作网页、读取目录、修改已有文本；可选连接 Navi 使用项目工具。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Navi Link",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "core/protocol.js",
        "core/page.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
